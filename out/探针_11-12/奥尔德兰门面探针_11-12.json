} }, { threshold: [0, .01, .25, .5, .75, .99] }).observe(sen);\n  } catch (e) {}\n\n  /* ---- 自动测的那一栏 ---- */\n  var ROWS = [['env', '窗口设备'], ['origin', '页面来源'], ['store', '存东西'], ['img', '外链图'], ['cv', '图进画布'], ['fetch', '外链数据'], ['js', '外链脚本'], ['mod', '外链模块'],\n    ['css', '外链样式'], ['font', '外链字体'], ['aud', '外链音频'], ['vid', '外链视频'], ['mir', '各个镜像'], ['gl', 'WebGL'], ['run', '运行能力'], ['cssf', '样式能力'],\n    ['fps', '帧率'], ['pol', '权限'], ['csp', '安全策略'], ['msg', '父页来信']];\n  var auto = $('auto');\n  ROWS.forEach(function (r) { var d = document.createElement('div'); d.className = 'row'; d.id = 'r-' + r[0]; d.innerHTML = '<b>' + r[1] + '</b><i class=\"w\">…</i><span></span>'; auto.appendChild(d); });\n  /* st: 1 行，0 不行，2 只是记一笔 */\n  function set(k, st, text) {\n    R[k] = { st: st, t: text };\n    var d = $('r-' + k); if (!d) return;\n    var i = d.children[1]; i.className = st === 1 ? 'y' : st === 0 ? 'n' : 'q'; i.textContent = st === 1 ? '✓' : st === 0 ? '✗' : '·';\n    d.children[2].textContent = text;\n    refresh();\n  }\n  var mk = function (b) { return b ? '✓' : '✗'; };\n  function timeout(p, ms, why) { return Promise.race([p, new Promise(function (_, rej) { setTimeout(function () { rej(new Error(why || '超时')); }, ms); })]); }\n\n  /* 窗口设备 */\n  (function () {\n    var ua = navigator.userAgent || '', vv = window.visualViewport;\n    set('env', 2, '窗' + innerWidth + 'x' + innerHeight + ' 屏' + screen.width + 'x' + screen.height + ' dpr' + (+(window.devicePixelRatio || 1).toFixed(2)) + ' 触' + (navigator.maxTouchPoints || 0) +\n      (vv ? ' vv' + Math.round(vv.width) + 'x' + Math.round(vv.height) : '') + ' 核' + (navigator.hardwareConcurrency || '?') + ' 存' + (navigator.deviceMemory || '?') +\n      (navigator.connection && navigator.connection.effectiveType ? ' 网' + navigator.connection.effectiveType : '') + ' ｜ ' + ua.slice(0, 150));\n  })();\n\n  /* 页面来源 */\n  (function () {\n    var anc = ''; try { var a = location.ancestorOrigins; if (a && a.length) anc = Arra