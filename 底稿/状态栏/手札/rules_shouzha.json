  "regex": "/^§底座｜纪元：((([^\\s·\\n]{3,14})(·[^\\s\\n]{1,40}|)) · (\\d{1,2}[:：]\\d{2})\\s?([^\\n·]{0,20})· ([^\\s\\n]{1,40}) · ([^\\s\\n]{1,40}) · 防抢话 (开|关) · 档位 ([^\\s\\n]{1,6}))\\s*\\n§环境｜([^｜\\n]{1,60})｜([^\\n]{0,80})$/m",
  "replaceString": "<details class=\"sz-hud\"><summary class=\"sz-head\"><b class=\"sz-title\"><span></span></b><span class=\"sz-sub\"><span class=\"sz-place\">$7</span><span class=\"sz-year\">$3</span><span class=\"sz-time\">$5</span></span>ⓑ<span class=\"sz-more\">推演</span></summary><div class=\"sz-hud-body\"><div class=\"sz-grid\"><div><b>日期</b>$2</div><div><b>时辰</b>$5 $6 · $12</div><div><b>天气</b>$11</div><div><b>地点</b>$7</div><div><b>潮汐</b>$8</div><div><b>档位</b>$10 · 防抢话 $9</div></div>ⓔ",
  "enabled": true,
  "messageRole": "assistant",
  "applyMode": "front-end"
 },
 {
  "name": "底座单行",
